# Compiled binaries -- rebuild with `make` in this directory (or, for
# permrank_proto, `c++ -O2 -std=c++17 -o permrank_proto permrank_proto.cpp`).
/bench
/extractor
/permrank_proto

# Data dumped by extract.cpp and consumed by bench.cpp -- regenerate with
# `make extractor && ./extractor` (needs twsearch built from this branch
# first; see the Makefile).
*_rotdata.h
*_samples.bin
*_fullsamples.bin

# Per-session benchmark output -- see run_megaminx_ab.sh, which regenerates
# these on every run.
/logs/
